#!/usr/bin/env bash
# Управление личным VPN. Использование: vpn <команда>
set -euo pipefail

STATE_DIR=/etc/myvpn
STATE_FILE=$STATE_DIR/params.env
CLIENT_DIR=/root/vpn-client

[[ $EUID -eq 0 ]] || { echo "Запусти от root (sudo vpn ...)"; exit 1; }
[[ -f $STATE_FILE ]] || { echo "VPN не установлен: сначала запусти install.sh"; exit 1; }
# shellcheck disable=SC1090
source "$STATE_FILE"

b='\033[1m'; g='\033[1;32m'; y='\033[1;33m'; o='\033[0m'

link_reality() {
  echo "vless://${XRAY_UUID}@${SERVER_IP}:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${REALITY_SNI}&fp=chrome&pbk=${XRAY_PUB}&sid=${XRAY_SID}&type=tcp&headerType=none#MyVPN-REALITY"
}
link_hy2() {
  echo "hysteria2://${HY2_PASS}@${SERVER_IP}:443/?sni=${HY2_SNI}&obfs=salamander&obfs-password=${HY2_OBFS}&insecure=1&pinSHA256=${HY2_PIN}#MyVPN-HY2"
}
link_hy2_hop() {
  [[ -n "${HOP_SUFFIX:-}" ]] || return 0
  echo "hysteria2://${HY2_PASS}@${SERVER_IP}:${HOP_SUFFIX}/?sni=${HY2_SNI}&obfs=salamander&obfs-password=${HY2_OBFS}&insecure=1&pinSHA256=${HY2_PIN}#MyVPN-HY2-HOP"
}

gen() {
  mkdir -p "$CLIENT_DIR"; chmod 700 "$CLIENT_DIR"
  {
    link_reality
    link_hy2
    link_hy2_hop
  } > "$CLIENT_DIR/links.txt"

  # Подписка (base64) — можно скормить v2rayN / Hiddify / Shadowrocket целиком
  base64 -w0 "$CLIENT_DIR/links.txt" > "$CLIENT_DIR/subscription.txt"

  local hop_line=""
  [[ -n "${HOP_SUFFIX:-}" ]] && hop_line="    ports: ${HOP_SUFFIX}"

  # Конфиг для Clash Verge Rev / mihomo (ядро Clash Meta)
  cat > "$CLIENT_DIR/clash-mihomo.yaml" <<EOF
# Clash Verge Rev / mihomo. Китайские сайты идут напрямую, остальное — через VPN.
mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: false
unified-delay: true
tcp-concurrent: true
find-process-mode: strict
geodata-mode: true
geo-auto-update: true
geo-update-interval: 72
geox-url:
  geoip: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
  geosite: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"

sniffer:
  enable: true
  sniff:
    HTTP: { ports: [80, 8080-8880], override-destination: true }
    TLS:  { ports: [443, 8443] }
    QUIC: { ports: [443, 8443] }

tun:
  enable: false          # включается переключателем «TUN / Режим виртуальной сетевой карты» в клиенте
  stack: mixed
  auto-route: true
  auto-detect-interface: true
  strict-route: true
  dns-hijack: ["any:53", "tcp://any:53"]

dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter: ["*.lan", "*.local", "+.msftconnecttest.com", "+.msftncsi.com", "time.*.com", "ntp.*.com"]
  default-nameserver: [223.5.5.5, 119.29.29.29]
  proxy-server-nameserver: [223.5.5.5, 119.29.29.29]
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  nameserver-policy:
    "geosite:cn,private": [223.5.5.5, 119.29.29.29]

proxies:
  - name: REALITY
    type: vless
    server: ${SERVER_IP}
    port: 443
    uuid: ${XRAY_UUID}
    network: tcp
    udp: true
    tls: true
    flow: xtls-rprx-vision
    servername: ${REALITY_SNI}
    client-fingerprint: chrome
    reality-opts:
      public-key: ${XRAY_PUB}
      short-id: ${XRAY_SID}

  - name: HYSTERIA2
    type: hysteria2
    server: ${SERVER_IP}
    port: 443
${hop_line}
    password: ${HY2_PASS}
    obfs: salamander
    obfs-password: ${HY2_OBFS}
    sni: ${HY2_SNI}
    skip-cert-verify: true
    alpn: [h3]

proxy-groups:
  - name: PROXY
    type: select
    proxies: [AUTO, REALITY, HYSTERIA2, DIRECT]
  - name: AUTO
    type: fallback
    proxies: [REALITY, HYSTERIA2]
    url: https://www.gstatic.com/generate_204
    interval: 120
    timeout: 3000
    lazy: false

rules:
  - GEOSITE,private,DIRECT
  - GEOIP,private,DIRECT,no-resolve
  - GEOSITE,category-ads-all,REJECT
  - GEOSITE,cn,DIRECT
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
EOF
  sed -i '/^$/N;/^\n$/D' "$CLIENT_DIR/clash-mihomo.yaml"
  chmod 600 "$CLIENT_DIR"/*
}

show() {
  gen
  echo -e "${b}======== 1) VLESS + REALITY (основной, TCP 443) ========${o}"
  echo -e "${g}$(link_reality)${o}"
  echo
  qrencode -t ansiutf8 -m 1 "$(link_reality)" 2>/dev/null || true
  echo
  echo -e "${b}======== 2) Hysteria2 (резервный, быстрый, UDP 443) ========${o}"
  echo -e "${g}$(link_hy2)${o}"
  echo
  qrencode -t ansiutf8 -m 1 "$(link_hy2)" 2>/dev/null || true
  if [[ -n "${HOP_SUFFIX:-}" ]]; then
    echo
    echo -e "${b}======== 3) Hysteria2 с port hopping (если UDP режут) ========${o}"
    echo -e "${g}$(link_hy2_hop)${o}"
  fi
  echo
  echo -e "${y}Файлы для клиента лежат в ${CLIENT_DIR}/:${o}"
  echo "  links.txt         — ссылки (Hiddify, v2rayN, NekoBox, Shadowrocket)"
  echo "  clash-mihomo.yaml — профиль для Clash Verge Rev (с правилами для Китая)"
  echo "  subscription.txt  — все ссылки одной base64-подпиской"
  echo
  echo "Скачать на ноутбук:  scp root@${SERVER_IP}:${CLIENT_DIR}/clash-mihomo.yaml ."
}

status() {
  for s in xray hysteria-server myvpn-porthop; do
    if systemctl is-active --quiet "$s"; then echo -e "  $s: ${g}работает${o}"
    else echo -e "  $s: ${y}НЕ работает${o}"; fi
  done
  echo
  echo "Порты:"; ss -lntup | grep -E ':443\s' || true
  echo
  echo "BBR: $(sysctl -n net.ipv4.tcp_congestion_control)"
  echo "Xray: $(/usr/local/bin/xray version | head -1)"
  echo "Hysteria: $(hysteria version 2>/dev/null | grep -i '^Version' | head -1)"
}

restart() {
  systemctl restart xray hysteria-server
  systemctl restart myvpn-porthop 2>/dev/null || true
  status
}

logs() {
  journalctl -u xray -u hysteria-server -n "${1:-60}" --no-pager
}

update() {
  echo "Обновляю Xray..."
  bash -c "$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install >/dev/null
  echo "Обновляю Hysteria2..."
  bash <(curl -fsSL https://get.hy2.sh/) >/dev/null
  restart
}

rotate() {
  echo "Сгенерирую НОВЫЕ ключи и пароли. Старые ссылки перестанут работать."
  read -rp "Продолжить? [y/N] " a; [[ $a == [yY] ]] || exit 0
  cp "$STATE_FILE" "$STATE_FILE.bak.$(date +%s)"
  sed -i -E '/^(XRAY_UUID|XRAY_PRIV|XRAY_PUB|XRAY_SID|HY2_PASS|HY2_OBFS)=/d' "$STATE_FILE"
  REALITY_SNI="$REALITY_SNI" HY2_SNI="$HY2_SNI" SERVER_IP="${NEW_IP:-$SERVER_IP}" bash "$STATE_DIR/install.sh"
}

sni() {
  local new=${1:-}
  [[ -n $new ]] || { echo "Использование: vpn sni www.example.com"; exit 1; }
  sed -i "s/^REALITY_SNI=.*/REALITY_SNI=$new/" "$STATE_FILE"
  REALITY_SNI="$new" HY2_SNI="$HY2_SNI" SERVER_IP="$SERVER_IP" bash "$STATE_DIR/install.sh"
}

uninstall() {
  read -rp "Полностью удалить VPN с сервера? [y/N] " a; [[ $a == [yY] ]] || exit 0
  systemctl disable --now myvpn-porthop 2>/dev/null || true
  rm -f /etc/systemd/system/myvpn-porthop.service
  bash -c "$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ remove --purge || true
  bash <(curl -fsSL https://get.hy2.sh/) --remove || true
  rm -rf /etc/hysteria "$STATE_DIR" "$CLIENT_DIR" /etc/sysctl.d/99-myvpn.conf /usr/local/bin/vpn
  systemctl daemon-reload
  echo "Удалено."
}

help() {
  cat <<EOF
vpn show        — показать ссылки и QR-коды, пересоздать файлы клиента
vpn status      — состояние сервисов
vpn restart     — перезапустить
vpn logs [N]    — последние N строк логов
vpn update      — обновить Xray и Hysteria2
vpn sni <домен> — сменить сайт маскировки REALITY
vpn rotate      — сменить все ключи/пароли (если что-то утекло)
vpn uninstall   — удалить всё
EOF
}

case "${1:-help}" in
  gen) gen ;;
  show|links|qr) show ;;
  status) status ;;
  restart) restart ;;
  logs) logs "${2:-60}" ;;
  update) update ;;
  rotate) rotate ;;
  sni) sni "${2:-}" ;;
  uninstall) uninstall ;;
  *) help ;;
esac
